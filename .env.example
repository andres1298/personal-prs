# Supabase Auth URL and publishable key (safe for browser use).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated verified Auth user UUIDs permitted to access the app.
# An empty list denies access. Invitations will replace this bootstrap list.
SUPABASE_ALLOWED_USER_IDS=

# Supabase Postgres. Copia las cadenas desde Dashboard > Connect.
# DATABASE_URL: Transaction pooler (puerto 6543), solo para código de servidor.
DATABASE_URL=
# DIRECT_DATABASE_URL: conexión directa (puerto 5432) para Prisma Migrate.
# Si tu red no admite IPv6, usa Session pooler (puerto 5432).
DIRECT_DATABASE_URL=
# En Vercel, la integración de Supabase provee POSTGRES_PRISMA_URL y
# POSTGRES_URL_NON_POOLING, que se usan si las dos anteriores están vacías.

# Independent disposable shadow database for Prisma Migrate development.
# Never use the runtime or migration database as the shadow database.
SHADOW_DATABASE_URL=
