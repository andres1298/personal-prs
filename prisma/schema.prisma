generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum MeasurementType {
  WEIGHT
  TIME
  // Maximum unbroken repetitions (gymnastics); higher is better.
  REPS
}

enum MovementCategory {
  LIFT
  CARDIO
  BENCHMARK
  GYMNASTICS
}

// Which of a session's fixed weights an athlete loads when the coach wrote one for each.
enum Division {
  MEN
  WOMEN
}

model Profile {
  // Supabase Auth identity; Auth tables remain externally managed.
  // Rows are created only by accepting an invitation or by admin bootstrap.
  id                 String           @id @db.Uuid
  displayName        String?
  email              String?          @unique
  invitedById        String?          @db.Uuid
  // Set by an admin to block access; the actor is kept as an audit trail.
  disabledAt         DateTime?        @db.Timestamptz(3)
  disabledById       String?          @db.Uuid
  // Set when the member finishes or skips the guided tour; null means a new member.
  tourCompletedAt    DateTime?        @db.Timestamptz(3)
  // Chosen at sign-up and editable in Settings; null until the member picks one.
  division           Division?
  // Set by an admin: the member can coach other members from then on.
  coachSince         DateTime?        @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  records            PersonalRecord[]
  ownedMovements     Movement[]       @relation("MovementOwner")
  hiddenMovements    HiddenMovement[]
  invitedBy          Profile?         @relation("ProfileInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  invitees           Profile[]        @relation("ProfileInviter")
  disabledBy         Profile?         @relation("ProfileDisabler", fields: [disabledById], references: [id], onDelete: Restrict)
  disabledProfiles   Profile[]        @relation("ProfileDisabler")
  invitationsSent    Invitation[]     @relation("InvitationInviter")
  acceptedInvitation Invitation?      @relation("InvitationAcceptance")
  athleteLinks       CoachAthlete[]   @relation("CoachLinkCoach")
  coachLinks         CoachAthlete[]   @relation("CoachLinkAthlete")
  trainingGroups     TrainingGroup[]
  groupMemberships   GroupMember[]
  coachInvites       CoachInvite[]
  trainingSessions   TrainingSession[] @relation("SessionCoach")
  assignedSessions   TrainingSession[] @relation("SessionAthlete")
  sessionLogs        SessionLog[]
  sessionComments    SessionComment[]
}

model Invitation {
  id                String    @id @default(uuid(7)) @db.Uuid
  // SHA-256 of the link token; the token itself is never stored.
  tokenHash         String    @unique
  name              String
  email             String
  invitedById       String    @db.Uuid
  expiresAt         DateTime  @db.Timestamptz(3)
  acceptedAt        DateTime? @db.Timestamptz(3)
  acceptedProfileId String?   @unique @db.Uuid
  revokedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  invitedBy         Profile   @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedProfile   Profile?  @relation("InvitationAcceptance", fields: [acceptedProfileId], references: [id], onDelete: Restrict)

  @@index([invitedById, acceptedAt, revokedAt])
}

model Movement {
  id              String           @id
  name            String
  category        MovementCategory
  groupName       String
  measurementType MeasurementType
  // Null marks the shared catalog; otherwise the movement is private to its owner.
  ownerId         String?          @db.Uuid
  records         PersonalRecord[]
  owner           Profile?         @relation("MovementOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  hiddenBy        HiddenMovement[]

  // The composite foreign key prevents records from changing measurement units.
  @@unique([id, measurementType])
  // Names are unique per owner. A partial index in the migration also keeps shared names
  // unique, because PostgreSQL treats null owners as distinct.
  @@unique([ownerId, name])
}

// A shared movement a member turned off for themselves; their records are kept.
model HiddenMovement {
  profileId  String   @db.Uuid
  movementId String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  movement   Movement @relation(fields: [movementId], references: [id], onDelete: Cascade)

  @@id([profileId, movementId])
}

model PersonalRecord {
  id              String          @id @default(uuid(7)) @db.Uuid
  profileId       String          @db.Uuid
  movementId      String
  measurementType MeasurementType
  value           Decimal         @db.Decimal(12, 3)
  performedOn     DateTime        @db.Date
  repetitionMax   Int?            @db.SmallInt
  notes           String?
  videoUrl        String?
  videoId         String?
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)
  profile         Profile         @relation(fields: [profileId], references: [id], onDelete: Restrict)
  movement        Movement        @relation(fields: [movementId, measurementType], references: [id, measurementType], onDelete: Restrict, onUpdate: Restrict)

  @@index([profileId, performedOn])
  @@index([profileId, movementId, repetitionMax, performedOn])
  @@index([movementId, measurementType])
}

// A coach and one of their athletes. The row stays after the link ends, so the coach
// keeps a history of former athletes; data access always requires endedAt to be null.
model CoachAthlete {
  id        String    @id @default(uuid(7)) @db.Uuid
  coachId   String    @db.Uuid
  athleteId String    @db.Uuid
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  endedAt   DateTime? @db.Timestamptz(3)
  // Who ended it: the athlete leaving or the coach removing them.
  endedById String?   @db.Uuid
  coach     Profile   @relation("CoachLinkCoach", fields: [coachId], references: [id], onDelete: Restrict)
  athlete   Profile   @relation("CoachLinkAthlete", fields: [athleteId], references: [id], onDelete: Restrict)

  // A partial unique index in the migration allows one active link per coach and athlete.
  @@index([coachId, endedAt])
  @@index([athleteId, endedAt])
}

model TrainingGroup {
  id         String            @id @default(uuid(7)) @db.Uuid
  coachId    String            @db.Uuid
  name       String
  // Block color token, e.g. "--b-blue".
  color      String
  // Reusable code athletes use to join; the coach can replace it at any time.
  joinCode   String            @unique
  archivedAt DateTime?         @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  coach      Profile           @relation(fields: [coachId], references: [id], onDelete: Restrict)
  members    GroupMember[]
  sessions   TrainingSession[]
  invites    CoachInvite[]

  @@index([coachId, archivedAt])
}

model GroupMember {
  groupId   String        @db.Uuid
  athleteId String        @db.Uuid
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  group     TrainingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  athlete   Profile       @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@id([groupId, athleteId])
  @@index([athleteId])
}

// Single-use link a coach sends to one person, who accepts it with their own account.
model CoachInvite {
  id           String         @id @default(uuid(7)) @db.Uuid
  coachId      String         @db.Uuid
  // SHA-256 of the link token; the token itself is never stored.
  tokenHash    String         @unique
  name         String
  groupId      String?        @db.Uuid
  expiresAt    DateTime       @db.Timestamptz(3)
  acceptedAt   DateTime?      @db.Timestamptz(3)
  acceptedById String?        @db.Uuid
  revokedAt    DateTime?      @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  coach        Profile        @relation(fields: [coachId], references: [id], onDelete: Restrict)
  group        TrainingGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([coachId, acceptedAt, revokedAt])
}

// One day of programming for a group or for one athlete (exactly one of the two; see the migration).
model TrainingSession {
  id          String           @id @default(uuid(7)) @db.Uuid
  coachId     String           @db.Uuid
  groupId     String?          @db.Uuid
  athleteId   String?          @db.Uuid
  date        DateTime         @db.Date
  title       String?
  notes       String?
  // Blocks and their lines, validated by normalizeContent in src/lib/training.js.
  content     Json
  // Null while it is a draft only the coach sees.
  publishedAt DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  coach       Profile          @relation("SessionCoach", fields: [coachId], references: [id], onDelete: Restrict)
  group       TrainingGroup?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  athlete     Profile?         @relation("SessionAthlete", fields: [athleteId], references: [id], onDelete: Restrict)
  logs        SessionLog[]
  comments    SessionComment[]

  // One session per day and target; null targets are distinct, so each index covers its own kind.
  @@unique([groupId, date])
  @@unique([coachId, athleteId, date])
  @@index([athleteId, date])
}

// What one athlete did in a session. It is kept as written when the coach edits the session later.
model SessionLog {
  sessionId   String          @db.Uuid
  athleteId   String          @db.Uuid
  // Results by line and block id, validated by normalizeResults in src/lib/training.js.
  results     Json
  completedAt DateTime?       @db.Timestamptz(3)
  // Last time the athlete opened the comments; newer coach comments count as unread.
  seenAt      DateTime?       @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  session     TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  athlete     Profile         @relation(fields: [athleteId], references: [id], onDelete: Restrict)

  @@id([sessionId, athleteId])
  @@index([athleteId])
}

// A private thread per session and athlete, between that athlete and the coach.
model SessionComment {
  id        String          @id @default(uuid(7)) @db.Uuid
  sessionId String          @db.Uuid
  athleteId String          @db.Uuid
  authorId  String          @db.Uuid
  body      String
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author    Profile         @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([sessionId, athleteId, createdAt])
}
